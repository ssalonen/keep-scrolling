.DS_Store
build/
.build/
DerivedData/
# Generated from project.yml by `xcodegen generate` on every build (see the
# Fastfile). Never commit it — a tracked project would drift from the spec and
# the spec would stop being the source of truth.
*.xcodeproj
*.xcarchive
*.ipa
Payload/

# fastlane. Gemfile.lock is NOT ignored — commit it so CI and local resolve the
# same gem versions.
vendor/
.bundle/
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
# Local secrets for fastlane (ASC private key, match passphrase). The committed
# .env.example is the template; the real .env must never be committed.
fastlane/.env
fastlane/.env.*
!fastlane/.env.example

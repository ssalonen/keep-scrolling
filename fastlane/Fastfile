# fastlane lanes for Keep Scrolling (iOS only).
#
# `beta` is the release lane (called by release.yml): generate the Xcode project
# from the web extension, sync signing, build a signed IPA, verify it actually
# ships the content scripts at the right bundle IDs and version, and upload to
# TestFlight. `build` does everything except the upload (local sanity check).
# `certificates` seeds/syncs signing from a Mac.
#
# Unlike a normal iOS repo there is NO committed .xcodeproj: Apple's
# safari-web-extension-converter generates the container app + extension appex
# targets at build time from extension/. Everything the old release.yml did in
# inline bash (convert, patch bundle IDs, pick a scheme, archive, package) lives
# here instead, so `bundle exec fastlane build` reproduces CI on a Mac.

default_platform(:ios)

# Xcode-facing name: drives the generated project, scheme, target, .app and .ipa
# filenames, so it deliberately has NO space — spaces there leak into every path
# and shell invocation downstream for no benefit.
APP_NAME = "KeepScrolling"
# What users actually see (home screen, Settings, Safari's extension list). Set
# as CFBundleDisplayName; independent of APP_NAME and of the bundle ID.
APP_DISPLAY_NAME = "Keep Scrolling"
# fi.mailhub.* matches the other apps under this Apple team (and the domain
# actually owned), which matters because match's signing repo is per-team.
APP_ID   = "fi.mailhub.keepscrolling"
# The converter nests the appex under the container app. We *set* this suffix
# explicitly rather than reading whatever the converter chose, so it can never
# drift out of sync with the Matchfile (match must have a profile for it).
EXT_ID   = "#{APP_ID}.Extension"

# Repo root. fastlane runs lanes with its CWD set to the fastlane/ dir, so a
# CWD-relative path would resolve to fastlane/… — wrong. Anchor every repo-file
# reference here instead. On CI this is the checkout root (GITHUB_WORKSPACE);
# locally, the parent of this Fastfile's directory.
REPO_ROOT     = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", __dir__)
EXTENSION_DIR = File.join(REPO_ROOT, "extension")
# Our container-app UI (feature overview + enable instructions), copied over the
# placeholder page the converter generates. See apply_app_ui.
APP_UI_DIR    = File.join(REPO_ROOT, "app")
BUILD_DIR     = File.join(REPO_ROOT, "build")
GEN_DIR       = File.join(BUILD_DIR, "gen")

# The files that are the actual product — verified present in the shipped IPA.
CONTENT_SCRIPTS = ["block-reddit-nag.js", "block-x-nag.js"]

# The in-Safari bug reporter: the popup, its logic, and the collector content
# script that hands it the page snapshot. Verified in the IPA alongside the
# content scripts — a missing one leaves the toolbar button opening a blank
# sheet, which nothing else would catch.
REPORT_FILES = ["report.html", "report.js", "collect-report.js"]

# Written into the generated extension's Resources by apply_build_info and read
# at runtime by report.js, so every filed bug names the build it came from.
# NOT the same as manifest.json's "version": the converter reads that one on the
# way to Info.plist (which generate_project then repoints at the build settings
# anyway), and rewriting it post-conversion would leave the two disagreeing.
BUILD_INFO_FILE = "build-info.json"

# The container app's web resources. This filename is the template's, and it is
# overwritten in place (never added) so the generated project's existing file
# reference and Copy-Bundle-Resources phase keep working.
#
# Main.html ONLY, deliberately: app/Main.html inlines its own CSS, JS and icon.
# The template ships no Script.js to overwrite, and it localizes the page into
# Base.lproj/ while plain resources land at the .app root — so a page split
# across sibling files could not reference them at runtime anyway.
APP_UI_FILES = ["Main.html"]
# Substituted into Main.html at build time; Script.js drops the element if this
# ever survives into a build.
APP_UI_VERSION_TOKEN = "__APP_VERSION__"
# A string that exists only in *our* page, not in the converter's placeholder —
# how verify_ipa proves the real UI shipped.
APP_UI_MARKER = 'class="features"'

platform :ios do
  desc "Sync signing material (read-only on CI) without building anything"
  lane :certificates do
    # force: true so this also creates a dedicated, password-known keychain when
    # run locally (e.g. seeding from a Mac). Without it, match installs into the
    # login keychain and can't run `security set-key-partition-list`
    # non-interactively — the identity never forms and match reports "could not
    # find the newly generated certificate installed" (errSecInternalComponent).
    setup_ci(force: true)
    match(api_key: asc_api_key, type: "appstore", readonly: FastlaneCore::Helper.ci?)
  end

  desc "Build a signed IPA without uploading (local signing sanity check)"
  lane :build do
    setup_ci if FastlaneCore::Helper.ci?
    ipa = build_signed_ipa(asc_api_key)
    UI.success("Built #{ipa}")
  end

  desc "Build and upload a signed build to TestFlight"
  lane :beta do
    setup_ci
    key = asc_api_key
    ipa = build_signed_ipa(key)
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      # Internal testers only — don't submit for external Beta App Review, and
      # don't block CI while App Store Connect processes the build.
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end
end

# Generate the Xcode project, sync signing, produce a signed App-Store IPA,
# verify it, and return its absolute path (for upload_to_testflight).
# MARKETING_VERSION comes from release.yml (the git tag); the build number is the
# CI run number, which must be unique and increasing for App Store Connect.
def build_signed_ipa(key)
  marketing_version = ENV["MARKETING_VERSION"] || "0.0.1"
  build_number      = ENV["GITHUB_RUN_NUMBER"] || "1"

  project, scheme, app_target, ext_target =
    generate_project(marketing_version, build_number)

  # readonly by default. To regenerate profiles from CI after changing App-ID
  # capabilities (instead of re-seeding from a Mac), run the "Bump version and
  # make a release" workflow with match_readonly: 'false' — that plumbs
  # MATCH_READONLY through release.yml to here. Needs a *write* deploy key in
  # MATCH_REPO_KEY and an API key allowed to manage profiles.
  match(api_key: key, type: "appstore", readonly: ENV["MATCH_READONLY"] != "false")

  # Stamp manual signing + the match profiles into the freshly generated
  # project. The converter emits automatic signing with no team; overriding it
  # per target here is what lets a team-less generated project build signed.
  apply_signing(project, app_target, ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"))
  apply_signing(project, ext_target, ENV.fetch("sigh_#{EXT_ID}_appstore_profile-name"))

  build_app(
    project: project,
    scheme: scheme,
    configuration: "Release",
    clean: true,
    output_directory: BUILD_DIR,
    output_name: "#{APP_NAME}.ipa",
    export_method: "app-store",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: ENV.fetch("APPLE_TEAM_ID"),
      signingCertificate: "Apple Distribution",
      provisioningProfiles: {
        APP_ID => ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"),
        EXT_ID => ENV.fetch("sigh_#{EXT_ID}_appstore_profile-name"),
      },
    },
    xcargs: [
      "MARKETING_VERSION=#{marketing_version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
    ].join(" "),
  )
  ipa = Fastlane::Actions.lane_context[Fastlane::Actions::SharedValues::IPA_OUTPUT_PATH]

  # Gate: fail before upload if the IPA is structurally wrong or misversioned.
  verify_ipa(ipa, marketing_version, build_number)
  ipa
end

# Run Apple's converter to produce the container app + extension appex targets,
# then patch the generated project so it is fit to sign, version, and upload.
# Returns [project_path, scheme, app_target_name, ext_target_name].
#
# The whole project is a build artifact under build/gen — it is regenerated from
# scratch every run and never committed, so patching it here is safe (contrast
# with a generator writing over a *tracked* file, which is what silently broke
# every-byte-counts; see docs/FASTLANE-MIGRATION.md).
def generate_project(marketing_version, build_number)
  require "xcodeproj"

  FileUtils.rm_rf(GEN_DIR)
  FileUtils.mkdir_p(GEN_DIR)

  sh(
    "xcrun", "safari-web-extension-converter", EXTENSION_DIR,
    "--ios-only",
    "--project-location", GEN_DIR,
    "--app-name", APP_NAME,
    "--bundle-identifier", APP_ID,
    "--no-open", "--no-prompt", "--force"
  )

  project_path = Dir.glob(File.join(GEN_DIR, "**", "*.xcodeproj")).min_by { |p| p.count(File::SEPARATOR) }
  UI.user_error!("safari-web-extension-converter produced no .xcodeproj under #{GEN_DIR}") if project_path.nil?

  # 0. Replace the converter's placeholder container-app page with ours before
  #    anything else touches the project, so a failure here stops the build
  #    early rather than after signing.
  apply_app_ui(marketing_version, build_number)

  # 0b. Re-enable the container app's scrolling (see enable_app_scrolling).
  enable_app_scrolling

  proj = Xcodeproj::Project.open(project_path)
  app  = find_target(proj, "com.apple.product-type.application", "container app")
  ext  = find_target(proj, "com.apple.product-type.app-extension", "Safari extension appex")

  # 0c. Copy in (and register) anything from extension/ the converter did not
  #     recognise as a resource — see sync_extension_resources.
  sync_extension_resources(proj, ext)

  # 0d. Stamp the version the bug reporter quotes (see apply_build_info).
  apply_build_info(marketing_version, build_number)

  # 1. Bundle identifiers. The converter builds the container app's id from
  #    --bundle-identifier's PREFIX plus --app-name, not from
  #    --bundle-identifier itself: here that yields fi.mailhub.KeepScrolling
  #    (capital K) against a real id of fi.mailhub.keepscrolling. That exact
  #    class of case mismatch broke Xcode's case-sensitive
  #    ValidateEmbeddedBinary check before (commit 8c1f2c9), and note that
  #    lowercasing our own id does NOT avoid it — the converter still invents a
  #    capitalised one. Forcing both ids here is what actually fixes it, and it
  #    also guarantees they line up with the profiles match minted.
  set_build_setting(app, "PRODUCT_BUNDLE_IDENTIFIER", APP_ID)
  set_build_setting(ext, "PRODUCT_BUNDLE_IDENTIFIER", EXT_ID)

  # 2. Versioning and display name. App Store Connect reads
  #    CFBundleShortVersionString / CFBundleVersion from each Info.plist and
  #    rejects a duplicate build number, so the tag version MUST reach the
  #    binary. The converter writes the literal manifest.json version ("1.0")
  #    into Info.plist, where an xcargs MARKETING_VERSION would be ignored —
  #    repoint those keys at the build settings so the override actually lands.
  #    CFBundleDisplayName is set here too, so the user-visible name is
  #    independent of the space-free APP_NAME that drives the build paths.
  [app, ext].each do |target|
    set_build_setting(target, "MARKETING_VERSION", marketing_version)
    set_build_setting(target, "CURRENT_PROJECT_VERSION", build_number)
    # The converter emits GENERATE_INFOPLIST_FILE=YES *alongside* an
    # INFOPLIST_FILE, which makes Xcode merge the INFOPLIST_KEY_* build settings
    # over the file's contents. It also sets
    # INFOPLIST_KEY_CFBundleDisplayName=<APP_NAME>, so the display name written
    # into the file by patch_infoplist is silently overridden and the IPA ships
    # "KeepScrolling" instead of "Keep Scrolling". Set the build setting too —
    # it is the one that actually wins. (The version keys need no equivalent:
    # they have no INFOPLIST_KEY_*, so the file's $(MARKETING_VERSION) /
    # $(CURRENT_PROJECT_VERSION) resolve against the settings set just above.)
    set_build_setting(target, "INFOPLIST_KEY_CFBundleDisplayName", APP_DISPLAY_NAME)
    # Export compliance. Without this key App Store Connect holds every build
    # behind a manual "does your app use encryption?" question before it can
    # reach testers. Declaring it in the binary answers that up front, so a
    # release needs no console babysitting. NO is the accurate answer here: the
    # content script only manipulates the DOM — it performs no encryption, and
    # the app makes no network calls of its own.
    set_build_setting(target, "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption", "NO")
    patch_infoplist(proj, target)
  end

  proj.save

  [project_path, pick_scheme(project_path), app.name, ext.name]
end

# Overwrite the container app's web resources with the ones in app/.
#
# The container app is the icon on the home screen: the converter ships it as a
# single line of placeholder text ("You can turn on … in Settings"), which is
# the only thing a user ever sees of this app besides Safari's toggle. app/
# replaces it with the feature overview + enable steps.
#
# It overwrites the template's own filename in place instead of adding files,
# so the generated project needs no modification: the file reference and the
# Copy Bundle Resources phase the converter already emitted keep pointing at
# exactly this path. Anything more (extra assets, renamed files) would have to
# be registered with xcodeproj as well, and would silently ship missing
# otherwise — which is why app/Main.html carries its CSS, JS and icon inline
# rather than as siblings.
def apply_app_ui(marketing_version, build_number)
  # Resolve each file by globbing for its own name, never by deriving a shared
  # directory: the converter localizes the page into Resources/Base.lproj/ while
  # other resources sit in Resources/ above it, and it ships no Script.js at
  # all. Assuming one directory held all three failed the v0.5.0 release, and
  # assuming the template's file set matched ours failed v0.5.1.
  dests = {}
  APP_UI_FILES.each do |name|
    src = File.join(APP_UI_DIR, name)
    UI.user_error!("Missing container-app UI file: #{src}") unless File.exist?(src)

    matches = Dir.glob(File.join(GEN_DIR, "**", name))
    if matches.size == 1
      dests[name] = matches.first
    else
      # Overwriting the template's own files in place is precisely what keeps
      # them bundled, so there is no safe way to continue. List what the
      # template does ship, so a template change is diagnosable from one failed
      # run instead of one per release.
      UI.user_error!(
        "Expected exactly 1 #{name} in the generated project, found #{matches.size}: #{matches.inspect}. " \
        "safari-web-extension-converter's app template changed — update apply_app_ui. Web resources " \
        "it generated: #{Dir.glob(File.join(GEN_DIR, '**', '*.{html,css,js}')).inspect}"
      )
    end
  end

  dests.each { |name, dest| FileUtils.cp(File.join(APP_UI_DIR, name), dest) }

  # Stamp the shipped version into the page footer. Done here, not in the HTML,
  # because the version only exists as the git tag at build time.
  main_html = dests.fetch("Main.html")
  contents = File.read(main_html)
  unless contents.include?(APP_UI_VERSION_TOKEN)
    UI.user_error!("#{APP_UI_VERSION_TOKEN} is missing from app/Main.html — the built app would show no version")
  end
  File.write(main_html, contents.gsub(APP_UI_VERSION_TOKEN, "Version #{marketing_version} (#{build_number})"))

  UI.message("Applied container-app UI from app/: #{dests.values.map { |p| p.sub("#{GEN_DIR}/", '') }.join(', ')}")
end

# Make sure every file in extension/ actually reached the generated appex.
#
# The converter does NOT copy the extension folder wholesale: it copies what the
# *manifest* points at (content scripts, icons, the popup page and what that page
# references). A file named only at runtime is invisible to it — report.js reads
# build-info.json through `runtime.getURL`, nothing in the manifest mentions it,
# and the v0.6.0 release died in apply_build_info with "found 0" because of
# exactly that. Declaring it in the manifest just to be copied would expose it as
# a web-accessible resource for no other reason, so sync it here instead.
#
# extension/ is the contract; whatever is missing gets copied in and registered,
# rather than this guessing which files the converter happens to recognise. That
# also covers the next runtime-only file someone adds (a popup asset, a data
# table) without another failed release to discover it.
def sync_extension_resources(proj, ext)
  # Anchor on the generated manifest rather than deriving the appex's Resources
  # path: the converter's layout is not a contract (same reasoning as
  # apply_app_ui), but the manifest is always at the root of what it copied.
  manifests = Dir.glob(File.join(GEN_DIR, "**", "manifest.json"))
  if manifests.size != 1
    UI.user_error!(
      "Expected exactly 1 manifest.json in the generated project, found #{manifests.size}: " \
      "#{manifests.inspect}. safari-web-extension-converter's output layout changed — update " \
      "sync_extension_resources."
    )
  end
  res_dir = File.dirname(manifests.first)

  sources = Dir.glob(File.join(EXTENSION_DIR, "*")).select { |p| File.file?(p) }.sort
  UI.user_error!("No files in #{EXTENSION_DIR} — there is no extension to ship") if sources.empty?

  copied = sources.reject { |src| File.exist?(File.join(res_dir, File.basename(src))) }
  copied.each do |src|
    dest = File.join(res_dir, File.basename(src))
    FileUtils.cp(src, dest)
    register_resource(proj, ext, dest)
  end

  if copied.empty?
    UI.message("All #{sources.size} extension/ files were copied by the converter")
  else
    UI.important(
      "The converter did not copy #{copied.map { |p| File.basename(p) }.join(', ')} from extension/ " \
      "(no manifest reference points at them) — copied and registered them in #{ext.name}'s resources."
    )
  end
end

# Add a file on disk to a target's Copy Bundle Resources phase.
#
# Copying a file into the generated tree does NOT bundle it: the project has to
# reference it too. That is the trap apply_app_ui sidesteps by overwriting the
# template's own files in place, and here there is no existing file to overwrite.
#
# The converter may reference the extension's Resources as a folder rather than
# file by file, in which case the copy alone is enough and adding a reference
# would give two build rules the same output ("Multiple commands produce"). Ask
# the project which shape it emitted instead of assuming either.
def register_resource(proj, target, path)
  phase = target.resources_build_phase
  return if phase.files.any? { |bf| bundles_path?(bf.file_ref, path) }

  # Keep the new reference next to its siblings in the navigator when they are
  # referenced individually; the group is cosmetic, the build phase is what ships.
  sibling = proj.files.find { |f| bundles_path?(f, File.join(File.dirname(path), "manifest.json")) }
  group = sibling&.parent || proj.main_group
  phase.add_file_reference(group.new_reference(path))
end

# Does this project reference already put `path` in the bundle — either as the
# file itself, or as a folder reference containing it?
def bundles_path?(ref, path)
  return false unless ref.respond_to?(:real_path)

  real = ref.real_path.to_s
  real == path || (File.directory?(real) && path.start_with?("#{real}#{File::SEPARATOR}"))
rescue StandardError
  false
end

# Stamp the shipped version into the extension's build-info.json.
#
# report.js reads this file to say which build a bug report came from. It has to
# be written at build time because the version only exists as the git tag then —
# the tracked copy carries placeholders, which is exactly what a local unstamped
# build should report.
#
# This rewrites the *generated* copy (put there by the converter or by
# sync_extension_resources) and never dirties the tracked file. Globbing for the
# filename rather than deriving the Resources path follows apply_app_ui: the
# converter's layout is not a contract.
def apply_build_info(marketing_version, build_number)
  require "json"

  matches = Dir.glob(File.join(GEN_DIR, "**", BUILD_INFO_FILE))
  if matches.size != 1
    UI.user_error!(
      "Expected exactly 1 #{BUILD_INFO_FILE} in the generated project, found #{matches.size}: " \
      "#{matches.inspect}. It ships in extension/ and sync_extension_resources copies it into the " \
      "appex's Resources — without it every bug report would claim an unknown version."
    )
  end

  File.write(matches.first, "#{JSON.pretty_generate('version' => marketing_version, 'build' => build_number)}\n")
  UI.message("Stamped #{BUILD_INFO_FILE} with #{marketing_version} (#{build_number})")
end

# Re-enable scrolling in the container app's web view.
#
# Apple's app template disables the web view's scroll view on iOS
# (`webView.scrollView.isScrollEnabled = false`) because the page it ships is a
# single line of placeholder text. Our page is a full overview screen, so with
# that line intact everything below the fold is simply unreachable — the app
# looks truncated and dead. Flip it to true instead of deleting the line, so
# the generated source still reads as a deliberate setting.
#
# Not fatal when the line is absent: that means the template no longer disables
# scrolling, which is the state we want anyway. app/Main.html additionally
# scrolls its own content in an overflow:auto container, so the page stays
# usable even if this patch silently stops matching.
def enable_app_scrolling
  sources = Dir.glob(File.join(GEN_DIR, "**", "*.swift"))
  UI.user_error!("safari-web-extension-converter produced no Swift sources under #{GEN_DIR}") if sources.empty?

  patched = sources.select do |path|
    contents = File.read(path)
    next false unless contents.include?("isScrollEnabled = false")

    File.write(path, contents.gsub("isScrollEnabled = false", "isScrollEnabled = true"))
    true
  end

  if patched.empty?
    UI.important(
      "No `isScrollEnabled = false` in the generated app sources — the template no longer disables " \
      "web view scrolling, or renamed it. Nothing to patch; app/Main.html scrolls its own content regardless."
    )
  else
    UI.message("Re-enabled container-app scrolling in: #{patched.map { |p| p.sub("#{GEN_DIR}/", '') }.join(', ')}")
  end
end

def find_target(proj, product_type, description)
  targets = proj.targets.select { |t| t.respond_to?(:product_type) && t.product_type == product_type }
  if targets.size != 1
    UI.user_error!(
      "Expected exactly 1 #{description} target (#{product_type}) in the generated " \
      "project, found #{targets.size}: #{targets.map(&:name).inspect}. " \
      "safari-web-extension-converter's output layout changed — update generate_project."
    )
  end
  targets.first
end

def set_build_setting(target, key, value)
  target.build_configurations.each { |c| c.build_settings[key] = value }
end

# Point the target's Info.plist version keys at the build settings, so the xcargs
# overrides in build_app are authoritative, and stamp the user-visible display
# name. A no-op when the target uses GENERATE_INFOPLIST_FILE (no file to patch —
# the settings are already the source of truth); verify_ipa is what proves the
# values reached the shipped binary either way.
#
# NOTE: the display name written here is NOT sufficient on its own — the
# converter also sets INFOPLIST_KEY_CFBundleDisplayName, which Xcode merges on
# top of this file. generate_project overrides that build setting for the same
# reason; keep both in sync.
def patch_infoplist(proj, target)
  rel = target.build_configurations
              .map { |c| c.build_settings["INFOPLIST_FILE"] }
              .compact.first
  return if rel.nil?

  path = File.expand_path(rel, File.dirname(proj.path))
  unless File.exist?(path)
    UI.important("INFOPLIST_FILE #{rel} for #{target.name} does not exist — skipping version repoint")
    return
  end

  plist = Xcodeproj::Plist.read_from_path(path)
  plist["CFBundleShortVersionString"] = "$(MARKETING_VERSION)"
  plist["CFBundleVersion"]            = "$(CURRENT_PROJECT_VERSION)"
  plist["CFBundleDisplayName"]        = APP_DISPLAY_NAME
  Xcodeproj::Plist.write_to_path(plist, path)
end

# Prefer the iOS app scheme; the converter names it '<App>' or '<App> (iOS)'.
def pick_scheme(project_path)
  schemes = Xcodeproj::Project.schemes(project_path)
  UI.user_error!("No schemes in #{project_path}") if schemes.empty?
  scheme = [APP_NAME, "#{APP_NAME} (iOS)"].find { |c| schemes.include?(c) } ||
           schemes.find { |s| !s.include?("Extension") } ||
           schemes.first
  UI.message("Using scheme: #{scheme}")
  scheme
end

def apply_signing(project, target, profile_name)
  update_code_signing_settings(
    path: project,
    use_automatic_signing: false,
    team_id: ENV.fetch("APPLE_TEAM_ID"),
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name,
    targets: [target],
    build_configurations: ["Release"],
  )
end

# Inspect the exported IPA and fail unless it is what we intend to ship. The
# converter is a black box that runs fresh on every release, so these are the
# invariants that a converter change (or a bad patch above) would break —
# checked against the *shipped artifact*, not against the inputs that produced
# it, so a patch silently failing to apply is caught rather than confirmed.
#
#   1. exactly one .app with the expected bundle id
#   2. exactly one embedded .appex, its id correctly nested under the app's
#      (the case-mismatch bug that broke ValidateEmbeddedBinary and re-signing)
#   3. both carry the tag's version + this run's build number, or App Store
#      Connect rejects the upload as a duplicate build
#   4. both carry the user-visible display name — the space-free APP_NAME drives
#      the build paths, so this is the only thing proving the real name shipped
#   5. the app declares export compliance, so App Store Connect does not park
#      the build behind a manual encryption question
#   6. the content scripts and manifest are actually inside the appex — a signed,
#      correctly-versioned IPA containing no extension code would otherwise sail
#      through to TestFlight and simply do nothing on device
#   7. the bug reporter's popup, its script and the collector are bundled, and
#      build-info.json carries this build's version — otherwise every report
#      filed from the extension would name the wrong build
#   8. the container app ships OUR overview page, versioned — if the converter
#      moves its template, apply_app_ui's copy would land somewhere unbundled
#      and the app would quietly fall back to Apple's placeholder line
def verify_ipa(ipa, marketing_version, build_number)
  # Explicitly bash, not fastlane's default shell: this script uses arrays and
  # nullglob to count matches, which POSIX sh does not have.
  sh("bash", "-c", <<~BASH)
    set -euo pipefail
    WORK="$(mktemp -d)"
    unzip -qo "#{ipa}" -d "$WORK"

    shopt -s nullglob
    apps=("$WORK/Payload/"*.app)
    [ "${#apps[@]}" -eq 1 ] || { echo "::error::expected 1 .app in the IPA, found ${#apps[@]}"; exit 1; }
    APP="${apps[0]}"

    appexes=("$APP/PlugIns/"*.appex)
    [ "${#appexes[@]}" -eq 1 ] || { echo "::error::expected 1 embedded .appex, found ${#appexes[@]}. The Safari extension is missing from the container app — the shipped app would do nothing."; exit 1; }
    EXT="${appexes[0]}"

    plist_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Info.plist"; }

    check_id() {
      got="$(plist_get "$1" CFBundleIdentifier)"
      [ "$got" = "$2" ] || { echo "::error::$(basename "$1"): CFBundleIdentifier is '$got', expected '$2'. Signing profiles are keyed on the bundle id, so this ships mis-signed."; exit 1; }
    }
    check_id "$APP" "#{APP_ID}"
    check_id "$EXT" "#{EXT_ID}"

    # Case-sensitive nesting: iOS requires the appex id to be prefixed by the
    # container app's id, and a case mismatch here is exactly what broke
    # ValidateEmbeddedBinary before.
    case "#{EXT_ID}" in
      "#{APP_ID}".*) ;;
      *) echo "::error::extension id '#{EXT_ID}' is not nested under app id '#{APP_ID}'"; exit 1 ;;
    esac

    check_version() {
      short="$(plist_get "$1" CFBundleShortVersionString)"
      build="$(plist_get "$1" CFBundleVersion)"
      echo "$(basename "$1"): version $short ($build)"
      [ "$short" = "#{marketing_version}" ] || { echo "::error::$(basename "$1"): CFBundleShortVersionString is '$short', expected '#{marketing_version}'. The version override did not reach Info.plist, so App Store Connect would see the wrong version."; exit 1; }
      [ "$build" = "#{build_number}" ] || { echo "::error::$(basename "$1"): CFBundleVersion is '$build', expected '#{build_number}'. App Store Connect rejects duplicate build numbers."; exit 1; }
    }
    check_version "$APP"
    check_version "$EXT"

    # The name users actually see. APP_NAME is deliberately space-free for the
    # build paths, so nothing else would catch the display name regressing to it.
    check_display_name() {
      got="$(plist_get "$1" CFBundleDisplayName)"
      [ "$got" = "#{APP_DISPLAY_NAME}" ] || { echo "::error::$(basename "$1"): CFBundleDisplayName is '$got', expected '#{APP_DISPLAY_NAME}'. The app would show the wrong name on the home screen and in Safari's extension list."; exit 1; }
    }
    check_display_name "$APP"
    check_display_name "$EXT"

    # Export compliance. Only the container app's value is what App Store
    # Connect reads, but a missing key is silent: the upload succeeds and the
    # build then sits in "Missing Compliance" until someone answers the question
    # by hand, which is exactly the toil this is meant to remove.
    got="$(plist_get "$APP" ITSAppUsesNonExemptEncryption)"
    [ "$got" = "false" ] || { echo "::error::$(basename "$APP"): ITSAppUsesNonExemptEncryption is '$got', expected 'false'. Without it App Store Connect holds the build behind a manual export-compliance question before testers can install it."; exit 1; }

    # The product itself must be in the appex's web resources, and so must the
    # bug reporter's popup + collector (a missing one only shows up as a blank
    # sheet behind the toolbar button, on device, after release).
    for f in #{(CONTENT_SCRIPTS + REPORT_FILES).map { |s| "\"#{s}\"" }.join(" ")} manifest.json; do
      find "$EXT" -name "$f" | grep -q . || { echo "::error::$f is not present in $(basename "$EXT") — the IPA would install an extension with no content script."; exit 1; }
    done

    # The version the bug reporter quotes. Unstamped, every report from every
    # release would claim the placeholder version and be useless for bisecting.
    INFO="$(find "$EXT" -name #{BUILD_INFO_FILE} -print -quit)"
    [ -n "$INFO" ] || { echo "::error::no #{BUILD_INFO_FILE} in $(basename "$EXT") — bug reports would not name a version"; exit 1; }
    grep -q '"version": "#{marketing_version}"' "$INFO" || { echo "::error::#{BUILD_INFO_FILE} does not carry version #{marketing_version}: $(cat "$INFO")"; exit 1; }
    grep -q '"build": "#{build_number}"' "$INFO" || { echo "::error::#{BUILD_INFO_FILE} does not carry build #{build_number}: $(cat "$INFO")"; exit 1; }

    # The container app's own UI: our overview page, with the version stamped
    # in. A converter template move would leave the placeholder page bundled and
    # our copy sitting unreferenced on disk — invisible without this check.
    MAIN_HTML="$(find "$APP" -name Main.html -print -quit)"
    [ -n "$MAIN_HTML" ] || { echo "::error::no Main.html in $(basename "$APP") — the container app has no UI"; exit 1; }
    grep -q '#{APP_UI_MARKER}' "$MAIN_HTML" || { echo "::error::the bundled Main.html is not the app/ overview page (missing '#{APP_UI_MARKER}') — the app would show the converter's placeholder text"; exit 1; }
    grep -q '#{APP_UI_VERSION_TOKEN}' "$MAIN_HTML" && { echo "::error::the bundled Main.html still contains the raw #{APP_UI_VERSION_TOKEN} placeholder"; exit 1; }
    grep -q 'Version #{marketing_version} (#{build_number})' "$MAIN_HTML" || { echo "::error::the bundled Main.html does not show version #{marketing_version} (#{build_number})"; exit 1; }
    # The page carries its own CSS/JS/icon, so Main.html being present, ours,
    # and correctly versioned is the whole check — there are no sibling assets
    # that could go missing independently.

    echo "OK: IPA ships '#{APP_DISPLAY_NAME}' (#{APP_ID} + #{EXT_ID}) at #{marketing_version} (#{build_number}) with the content scripts and the app overview UI"
  BASH
end

# App Store Connect API key from the existing repo secrets. key_content is the
# raw .p8 text (not base64), matching how APP_STORE_CONNECT_API_KEY_P8 is stored.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
    is_key_content_base64: false,
    in_house: false, # standard Developer Program, NOT enterprise
  )
end

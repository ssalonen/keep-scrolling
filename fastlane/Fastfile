# fastlane lanes for Keep Scrolling (iOS only).
#
# `beta` is the release lane (called by release.yml): generate the Xcode project
# from project.yml, sync signing, build a signed IPA, verify it actually ships
# the content scripts at the right bundle IDs and version, and upload to
# TestFlight. `build` does everything except the upload (local sanity check).
# `project` stops after generating, for opening in Xcode. `certificates`
# seeds/syncs signing from a Mac.
#
# There is still NO committed .xcodeproj — it is generated into the repo root by
# `xcodegen generate` and gitignored. What changed in v0.7.0 is *what generates
# it*: Apple's safari-web-extension-converter used to invent the whole project
# from extension/ on every run, and this file spent ~260 lines patching its
# output back into shape. The native sources under native/ are now tracked, so
# the generator has nothing to guess and this file has nothing to correct.
# docs/FASTLANE-MIGRATION.md has the full before/after.

default_platform(:ios)

# Xcode-facing name: drives the project, scheme, target, .app and .ipa
# filenames, so it deliberately has NO space — spaces there leak into every path
# and shell invocation downstream for no benefit. Must match `name:` and the
# app target in project.yml.
APP_NAME = "KeepScrolling"
# What users actually see (home screen, Settings, Safari's extension list). Set
# as CFBundleDisplayName in native/*/Info.plist; independent of APP_NAME and of
# the bundle ID.
APP_DISPLAY_NAME = "Keep Scrolling"
# The appex target in project.yml. Also the Swift module name the appex's
# NSExtensionPrincipalClass is qualified with.
EXT_TARGET_NAME = "KeepScrollingExtension"
# fi.mailhub.* matches the other apps under this Apple team (and the domain
# actually owned), which matters because match's signing repo is per-team.
# These must agree with PRODUCT_BUNDLE_IDENTIFIER in project.yml and with the
# Matchfile; verify_ipa asserts them on the shipped artifact.
APP_ID   = "fi.mailhub.keepscrolling"
EXT_ID   = "#{APP_ID}.Extension"

# Repo root. fastlane runs lanes with its CWD set to the fastlane/ dir, so a
# CWD-relative path would resolve to fastlane/… — wrong. Anchor every repo-file
# reference here instead. On CI this is the checkout root (GITHUB_WORKSPACE);
# locally, the parent of this Fastfile's directory.
REPO_ROOT     = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", __dir__)
EXTENSION_DIR = File.join(REPO_ROOT, "extension")
# Our container-app UI (feature overview + enable instructions).
APP_UI_DIR    = File.join(REPO_ROOT, "app")
BUILD_DIR     = File.join(REPO_ROOT, "build")

# Web resources are copied here and stamped with the build's version before
# xcodegen runs, so a build never writes to a tracked file. That was the bug
# that broke the reference repo (every-byte-counts): its generator wrote over
# tracked .entitlements files, and the drift was invisible until release.
STAGE_DIR           = File.join(BUILD_DIR, "staged")
STAGED_EXTENSION_DIR = File.join(STAGE_DIR, "extension")
STAGED_APP_DIR       = File.join(STAGE_DIR, "app")

PROJECT_SPEC = File.join(REPO_ROOT, "project.yml")
PROJECT_PATH = File.join(REPO_ROOT, "#{APP_NAME}.xcodeproj")

# The files that are the actual product — verified present in the shipped IPA.
CONTENT_SCRIPTS = ["block-reddit-nag.js", "block-x-nag.js"]

# The in-Safari bug reporter: the popup, its logic, and the collector content
# script that hands it the page snapshot. Verified in the IPA alongside the
# content scripts — a missing one leaves the toolbar button opening a blank
# sheet, which nothing else would catch.
REPORT_FILES = ["report.html", "report.js", "collect-report.js"]

# Stamped by stage_sources and read at runtime by report.js, so every filed bug
# names the build it came from. NOT the same as manifest.json's "version", which
# stays a placeholder — nothing reads it now that the Info.plists are tracked.
BUILD_INFO_FILE = "build-info.json"

# The container app's page, and the token stage_sources substitutes the build's
# version into.
APP_UI_MAIN = "Main.html"
APP_UI_VERSION_TOKEN = "__APP_VERSION__"
# A string that exists only in *our* page — how verify_ipa proves the real UI
# shipped rather than an empty or stale file.
APP_UI_MARKER = 'class="features"'

platform :ios do
  desc "Sync signing material (read-only on CI) without building anything"
  lane :certificates do
    # force: true so this also creates a dedicated, password-known keychain when
    # run locally (e.g. seeding from a Mac). Without it, match installs into the
    # login keychain and can't run `security set-key-partition-list`
    # non-interactively — the identity never forms and match reports "could not
    # find the newly generated certificate installed" (errSecInternalComponent).
    setup_ci(force: true)
    match(api_key: asc_api_key, type: "appstore", readonly: FastlaneCore::Helper.ci?)
  end

  desc "Stage web resources and generate the Xcode project (for opening in Xcode)"
  lane :project do
    # project.yml's `build/staged/…` source paths do not exist in a clean
    # checkout, so a bare `xcodegen generate` fails. Use this instead.
    generate_project(ENV["MARKETING_VERSION"] || "0.0.1", ENV["GITHUB_RUN_NUMBER"] || "1")
    UI.success("Generated #{PROJECT_PATH} — open it with: xed #{PROJECT_PATH}")
  end

  desc "Build a signed IPA without uploading (local signing sanity check)"
  lane :build do
    setup_ci if FastlaneCore::Helper.ci?
    ipa = build_signed_ipa(asc_api_key)
    UI.success("Built #{ipa}")
  end

  desc "Build and upload a signed build to TestFlight"
  lane :beta do
    setup_ci
    key = asc_api_key
    ipa = build_signed_ipa(key)
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      # Internal testers only — don't submit for external Beta App Review, and
      # don't block CI while App Store Connect processes the build.
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end
end

# Generate the Xcode project, sync signing, produce a signed App-Store IPA,
# verify it, and return its absolute path (for upload_to_testflight).
# MARKETING_VERSION comes from release.yml (the git tag); the build number is the
# CI run number, which must be unique and increasing for App Store Connect.
def build_signed_ipa(key)
  marketing_version = ENV["MARKETING_VERSION"] || "0.0.1"
  build_number      = ENV["GITHUB_RUN_NUMBER"] || "1"

  generate_project(marketing_version, build_number)

  # readonly by default. To regenerate profiles from CI after changing App-ID
  # capabilities (instead of re-seeding from a Mac), run the "Bump version and
  # make a release" workflow with match_readonly: 'false' — that plumbs
  # MATCH_READONLY through release.yml to here. Needs a *write* deploy key in
  # MATCH_REPO_KEY and an API key allowed to manage profiles.
  match(api_key: key, type: "appstore", readonly: ENV["MATCH_READONLY"] != "false")

  # Stamp manual signing + the match profiles onto each target. project.yml
  # deliberately leaves signing unset so a local Debug build can use automatic
  # signing with whatever team the developer has.
  apply_signing(PROJECT_PATH, APP_NAME, ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"))
  apply_signing(PROJECT_PATH, EXT_TARGET_NAME, ENV.fetch("sigh_#{EXT_ID}_appstore_profile-name"))

  build_app(
    project: PROJECT_PATH,
    scheme: APP_NAME,
    configuration: "Release",
    clean: true,
    output_directory: BUILD_DIR,
    output_name: "#{APP_NAME}.ipa",
    export_method: "app-store",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: ENV.fetch("APPLE_TEAM_ID"),
      signingCertificate: "Apple Distribution",
      provisioningProfiles: {
        APP_ID => ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"),
        EXT_ID => ENV.fetch("sigh_#{EXT_ID}_appstore_profile-name"),
      },
    },
    xcargs: [
      "MARKETING_VERSION=#{marketing_version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
    ].join(" "),
  )
  ipa = Fastlane::Actions.lane_context[Fastlane::Actions::SharedValues::IPA_OUTPUT_PATH]

  # Gate: fail before upload if the IPA is structurally wrong or misversioned.
  verify_ipa(ipa, marketing_version, build_number)
  ipa
end

# Stage the web resources, then generate the Xcode project from project.yml.
#
# The project is a build artifact: regenerated from scratch every run and
# gitignored, so nothing tracked is produced by a build and there is no
# `git diff --exit-code` gate to keep honest.
def generate_project(marketing_version, build_number)
  stage_sources(marketing_version, build_number)

  FileUtils.rm_rf(PROJECT_PATH)
  sh("xcodegen", "generate", "--spec", PROJECT_SPEC, "--project", REPO_ROOT, "--quiet")
  UI.user_error!("xcodegen produced no project at #{PROJECT_PATH}") unless File.directory?(PROJECT_PATH)

  verify_project_shape
  PROJECT_PATH
end

# Copy extension/ and app/ into build/staged/ and stamp the build's version into
# the two places that carry it.
#
# Staging exists so the version substitution never touches a tracked file: the
# repo's build-info.json keeps its 0.0.0-dev placeholders and app/Main.html keeps
# its raw __APP_VERSION__ token, which is exactly what an unstamped local build
# should report.
#
# Both directories are copied wholesale and bundled wholesale (project.yml
# references the staged directories, and xcodegen enumerates them at generate
# time), so adding a file to extension/ or app/ needs no change here and no
# manifest entry. Three releases died on the converter-era alternative:
#
#   v0.6.0 — the converter copied only what manifest.json pointed at, and
#            build-info.json is named nowhere but in report.js's runtime.getURL.
#   v0.6.1 — globbing build/gen for manifest.json ALSO found 0, on a file every
#            shipped IPA demonstrably contains. The diagnosis: the converter
#            keeps no copy of extension/ inside the generated project at all —
#            the project *references* the tracked directory (directly, or via a
#            symlinked Resources dir, which `Dir.glob "**"` does not descend
#            into). No search under the generated tree could ever have matched.
#
# That second finding is why staging is not merely tidy. A generator that hands
# back references into the working tree turns "stamp the version" into "rewrite
# a tracked file", which dirties a dev machine's checkout and makes the build
# non-reproducible. Copying first means the paths written below are ours by
# construction — and stamp_target! refuses if that ever stops being true.
def stage_sources(marketing_version, build_number)
  require "json"

  FileUtils.rm_rf(STAGE_DIR)
  stage_dir(EXTENSION_DIR, STAGED_EXTENSION_DIR, "extension")
  stage_dir(APP_UI_DIR, STAGED_APP_DIR, "app")

  # 1. The version the bug reporter quotes. Without it, every report from every
  #    release would name the placeholder version and be useless for bisecting.
  build_info = stamp_target!(File.join(STAGED_EXTENSION_DIR, BUILD_INFO_FILE))
  unless File.exist?(build_info)
    UI.user_error!("extension/#{BUILD_INFO_FILE} is missing — bug reports would not name a version")
  end
  File.write(build_info, "#{JSON.pretty_generate('version' => marketing_version, 'build' => build_number)}\n")

  # 2. The version in the container app's footer. Substituted here, not written
  #    into the HTML, because the version only exists as the git tag at build
  #    time.
  #
  #    This rewrites EVERY occurrence of the token, so app/Main.html must
  #    contain exactly one (the footer) — a second one, e.g. inside the inline
  #    script, would be rewritten too and silently change behaviour. That is why
  #    the page detects an unsubstituted footer by shape (/^Version\s/) rather
  #    than by comparing against the token. test/extension.test.js enforces the
  #    "exactly once" rule.
  main_html = stamp_target!(File.join(STAGED_APP_DIR, APP_UI_MAIN))
  UI.user_error!("Missing container-app UI file: app/#{APP_UI_MAIN}") unless File.exist?(main_html)

  contents = File.read(main_html)
  unless contents.include?(APP_UI_VERSION_TOKEN)
    UI.user_error!("#{APP_UI_VERSION_TOKEN} is missing from app/#{APP_UI_MAIN} — the built app would show no version")
  end
  File.write(main_html, contents.gsub(APP_UI_VERSION_TOKEN, "Version #{marketing_version} (#{build_number})"))

  UI.message("Staged #{Dir.glob(File.join(STAGE_DIR, '*', '*')).size} web resources at #{marketing_version} (#{build_number})")
end

# Refuse to stamp a version through a path that resolves back into the tracked
# tree, and return the path when it is safe to write.
#
# Structurally this cannot happen: the callers build their paths from STAGE_DIR.
# It is here because the failure it guards against is silent and expensive —
# v0.6.1 established that a generated project can hand back references straight
# into extension/, and a build that rewrites tracked files corrupts a dev
# machine's checkout and stops being reproducible. Resolved with realpath so a
# symlinked staging directory cannot smuggle the write back in; `Dir.glob "**"`
# not descending into symlinks is exactly what hid the v0.6.1 layout.
def stamp_target!(path)
  resolved = File.realpath(File.dirname(path))
  [EXTENSION_DIR, APP_UI_DIR].each do |tracked|
    next unless resolved == File.realpath(tracked)

    UI.user_error!(
      "Refusing to stamp #{path}: it resolves inside the tracked #{File.basename(tracked)}/. " \
      "The version must only ever be written into the staged copies under #{STAGE_DIR}, or the " \
      "build rewrites the working tree and stops being reproducible."
    )
  end
  path
end

# Copy one tracked directory's files into the staging area, failing loudly if it
# is empty — an empty extension/ would otherwise produce a signed, correctly
# versioned IPA that installs an extension with no code in it.
def stage_dir(src, dest, label)
  files = Dir.glob(File.join(src, "*")).select { |p| File.file?(p) }.sort
  UI.user_error!("No files in #{label}/ — there is nothing to ship") if files.empty?

  FileUtils.mkdir_p(dest)
  files.each { |f| FileUtils.cp(f, File.join(dest, File.basename(f))) }
end

# Confirm the generated project still has the targets and scheme this file names.
#
# project.yml and this Fastfile have to agree on three strings, and nothing else
# would catch them drifting: a renamed target fails later, inside
# update_code_signing_settings, with an error about a target that "does not
# exist" and no hint about which file is wrong.
def verify_project_shape
  require "xcodeproj"

  proj = Xcodeproj::Project.open(PROJECT_PATH)
  names = proj.targets.map(&:name)
  [APP_NAME, EXT_TARGET_NAME].each do |wanted|
    next if names.include?(wanted)

    UI.user_error!(
      "project.yml generated no target named '#{wanted}' (got #{names.inspect}). " \
      "The Fastfile and project.yml must agree on the target names."
    )
  end

  schemes = Xcodeproj::Project.schemes(PROJECT_PATH)
  unless schemes.include?(APP_NAME)
    UI.user_error!(
      "project.yml generated no shared scheme named '#{APP_NAME}' (got #{schemes.inspect}). " \
      "build_app needs it by name."
    )
  end
end

def apply_signing(project, target, profile_name)
  update_code_signing_settings(
    path: project,
    use_automatic_signing: false,
    team_id: ENV.fetch("APPLE_TEAM_ID"),
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name,
    targets: [target],
    build_configurations: ["Release"],
  )
end

# Inspect the exported IPA and fail unless it is what we intend to ship.
#
# These checks predate the move off the converter, when the project was invented
# fresh on every release and this was the only thing standing between a converter
# change and a broken TestFlight build. They matter less now that project.yml and
# native/ are tracked and reviewable — but they read the *shipped artifact*
# rather than the inputs that produced it, which is the one property that makes a
# check worth having, so they stay:
#
#   1. exactly one .app with the expected bundle id
#   2. exactly one embedded .appex, its id correctly nested under the app's
#      (the case mismatch that used to break ValidateEmbeddedBinary)
#   3. both carry the tag's version + this run's build number, or App Store
#      Connect rejects the upload as a duplicate build
#   4. both carry the user-visible display name — the space-free APP_NAME drives
#      the build paths, so this is the only thing proving the real name shipped
#   5. the app declares export compliance, so App Store Connect does not park
#      the build behind a manual encryption question
#   6. every file in extension/ is actually inside the appex, and build-info.json
#      carries this build's version — a signed, correctly-versioned IPA
#      containing no extension code would otherwise sail through to TestFlight
#      and simply do nothing on device
#   7. the container app ships OUR overview page, versioned, rather than an empty
#      or unstamped one
def verify_ipa(ipa, marketing_version, build_number)
  # extension/ is the contract, so check the whole directory rather than a list
  # that can fall behind it. The named constants are unioned in as a floor: if a
  # file is ever deleted from extension/, the glob quietly shrinks but these
  # still fail.
  expected = (
    Dir.glob(File.join(EXTENSION_DIR, "*")).select { |p| File.file?(p) }.map { |p| File.basename(p) } +
    CONTENT_SCRIPTS + REPORT_FILES + ["manifest.json"]
  ).uniq.sort

  # Explicitly bash, not fastlane's default shell: this script uses arrays and
  # nullglob to count matches, which POSIX sh does not have.
  sh("bash", "-c", <<~BASH)
    set -euo pipefail
    WORK="$(mktemp -d)"
    unzip -qo "#{ipa}" -d "$WORK"

    shopt -s nullglob
    apps=("$WORK/Payload/"*.app)
    [ "${#apps[@]}" -eq 1 ] || { echo "::error::expected 1 .app in the IPA, found ${#apps[@]}"; exit 1; }
    APP="${apps[0]}"

    appexes=("$APP/PlugIns/"*.appex)
    [ "${#appexes[@]}" -eq 1 ] || { echo "::error::expected 1 embedded .appex, found ${#appexes[@]}. The Safari extension is missing from the container app — the shipped app would do nothing."; exit 1; }
    EXT="${appexes[0]}"

    plist_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Info.plist"; }

    check_id() {
      got="$(plist_get "$1" CFBundleIdentifier)"
      [ "$got" = "$2" ] || { echo "::error::$(basename "$1"): CFBundleIdentifier is '$got', expected '$2'. Signing profiles are keyed on the bundle id, so this ships mis-signed."; exit 1; }
    }
    check_id "$APP" "#{APP_ID}"
    check_id "$EXT" "#{EXT_ID}"

    # Case-sensitive nesting: iOS requires the appex id to be prefixed by the
    # container app's id, and a case mismatch here is exactly what broke
    # ValidateEmbeddedBinary before.
    case "#{EXT_ID}" in
      "#{APP_ID}".*) ;;
      *) echo "::error::extension id '#{EXT_ID}' is not nested under app id '#{APP_ID}'"; exit 1 ;;
    esac

    # The appex must declare itself a Safari web extension, or it installs and
    # is simply never loaded by Safari.
    point="$(plist_get "$EXT" "NSExtension:NSExtensionPointIdentifier")"
    [ "$point" = "com.apple.Safari.web-extension" ] || { echo "::error::$(basename "$EXT"): NSExtensionPointIdentifier is '$point', expected 'com.apple.Safari.web-extension'. Safari would never load the extension."; exit 1; }

    check_version() {
      short="$(plist_get "$1" CFBundleShortVersionString)"
      build="$(plist_get "$1" CFBundleVersion)"
      echo "$(basename "$1"): version $short ($build)"
      [ "$short" = "#{marketing_version}" ] || { echo "::error::$(basename "$1"): CFBundleShortVersionString is '$short', expected '#{marketing_version}'. The version override did not reach Info.plist, so App Store Connect would see the wrong version."; exit 1; }
      [ "$build" = "#{build_number}" ] || { echo "::error::$(basename "$1"): CFBundleVersion is '$build', expected '#{build_number}'. App Store Connect rejects duplicate build numbers."; exit 1; }
    }
    check_version "$APP"
    check_version "$EXT"

    # The name users actually see. APP_NAME is deliberately space-free for the
    # build paths, so nothing else would catch the display name regressing to it.
    check_display_name() {
      got="$(plist_get "$1" CFBundleDisplayName)"
      [ "$got" = "#{APP_DISPLAY_NAME}" ] || { echo "::error::$(basename "$1"): CFBundleDisplayName is '$got', expected '#{APP_DISPLAY_NAME}'. The app would show the wrong name on the home screen and in Safari's extension list."; exit 1; }
    }
    check_display_name "$APP"
    check_display_name "$EXT"

    # Export compliance. Only the container app's value is what App Store
    # Connect reads, but a missing key is silent: the upload succeeds and the
    # build then sits in "Missing Compliance" until someone answers the question
    # by hand, which is exactly the toil this is meant to remove.
    got="$(plist_get "$APP" ITSAppUsesNonExemptEncryption)"
    [ "$got" = "false" ] || { echo "::error::$(basename "$APP"): ITSAppUsesNonExemptEncryption is '$got', expected 'false'. Without it App Store Connect holds the build behind a manual export-compliance question before testers can install it."; exit 1; }

    # Everything in extension/ must have reached the appex's bundle root, where
    # Safari reads manifest.json from.
    for f in #{expected.map { |s| "\"#{s}\"" }.join(" ")}; do
      [ -e "$EXT/$f" ] || { echo "::error::$f is not at the root of $(basename "$EXT") — project.yml bundles build/staged/extension file by file, so every file in extension/ should land there. A missing content script means the IPA installs an extension that does nothing."; exit 1; }
    done

    # The version the bug reporter quotes. Unstamped, every report from every
    # release would claim the placeholder version and be useless for bisecting.
    INFO="$EXT/#{BUILD_INFO_FILE}"
    grep -q '"version": "#{marketing_version}"' "$INFO" || { echo "::error::#{BUILD_INFO_FILE} does not carry version #{marketing_version}: $(cat "$INFO")"; exit 1; }
    grep -q '"build": "#{build_number}"' "$INFO" || { echo "::error::#{BUILD_INFO_FILE} does not carry build #{build_number}: $(cat "$INFO")"; exit 1; }

    # The container app's own UI: our overview page, with the version stamped in.
    MAIN_HTML="$APP/#{APP_UI_MAIN}"
    [ -e "$MAIN_HTML" ] || { echo "::error::no #{APP_UI_MAIN} at the root of $(basename "$APP") — the container app has no UI"; exit 1; }
    grep -q '#{APP_UI_MARKER}' "$MAIN_HTML" || { echo "::error::the bundled #{APP_UI_MAIN} is not the app/ overview page (missing '#{APP_UI_MARKER}')"; exit 1; }
    grep -q '#{APP_UI_VERSION_TOKEN}' "$MAIN_HTML" && { echo "::error::the bundled #{APP_UI_MAIN} still contains the raw #{APP_UI_VERSION_TOKEN} placeholder"; exit 1; }
    grep -q 'Version #{marketing_version} (#{build_number})' "$MAIN_HTML" || { echo "::error::the bundled #{APP_UI_MAIN} does not show version #{marketing_version} (#{build_number})"; exit 1; }
    # The page carries its own CSS/JS/icon, so Main.html being present, ours,
    # and correctly versioned is the whole check — there are no sibling assets
    # that could go missing independently.

    echo "OK: IPA ships '#{APP_DISPLAY_NAME}' (#{APP_ID} + #{EXT_ID}) at #{marketing_version} (#{build_number}) with #{expected.size} extension files and the app overview UI"
  BASH
end

# App Store Connect API key from the existing repo secrets. key_content is the
# raw .p8 text (not base64), matching how APP_STORE_CONNECT_API_KEY_P8 is stored.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
    is_key_content_base64: false,
    in_house: false, # standard Developer Program, NOT enterprise
  )
end
